{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-scheduler", "./pushover-notify.js", "octto"],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["bun", "x", "chrome-devtools-mcp@latest"]
    }
  },
  "permission": {
    "*": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "**": "allow"
    },
    "read": {
      "*": "allow"
    }
  }
}
